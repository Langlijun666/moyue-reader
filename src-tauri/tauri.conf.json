{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨阅",
  "version": "0.1.0",
  "identifier": "com.moyue.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "墨阅 · 电子书阅读器",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/music/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "一个安静的桌面 EPUB / TXT 阅读器",
    "longDescription": "墨阅是一款本地优先的桌面 EPUB / TXT 阅读器，支持本地书库、目录导航、阅读进度记忆、主题与排版调整。"
  }
}
