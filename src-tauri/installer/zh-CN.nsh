; Branded copy for the NSIS welcome / finish pages.
; Kept short and explicitly wrapped because CJK text in the classic
; NSIS welcome page does not wrap at character boundaries.

LangString MUI_TEXT_WELCOME_INFO_TITLE ${LANG_SIMPCHINESE} "安装墨阅"
LangString MUI_TEXT_WELCOME_INFO_TEXT ${LANG_SIMPCHINESE} "本地优先的 EPUB / TXT 阅读器。$\r$\n$\r$\n安装到当前用户目录，无需管理员权限。$\r$\n$\r$\n点击「下一步」继续。"

LangString MUI_TEXT_FINISH_INFO_TITLE ${LANG_SIMPCHINESE} "墨阅已安装"
LangString MUI_TEXT_FINISH_INFO_TEXT ${LANG_SIMPCHINESE} "书架、阅读进度和音乐都保存在本机。$\r$\n$\r$\n现在可以开始安静地读一会儿了。"
LangString MUI_TEXT_FINISH_RUN ${LANG_SIMPCHINESE} "运行墨阅"
